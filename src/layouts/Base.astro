---
import { getCollection } from 'astro:content';
import 'katex/dist/katex.min.css';
import '../styles/global.css';

export interface Props {
  title: string;
}

const { title } = Astro.props;
const pageTitle = title === 'Home' ? 'Song\'s Weblog' : `${title} — Song's Weblog`;

const allPosts = await getCollection('posts');
const sortedPosts = allPosts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

function fmtDate(d: Date) {
  return d.toISOString().slice(0, 10);
}
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{pageTitle}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;0,700;0,800;1,400;1,700&display=swap" rel="stylesheet">
</head>
<body>
  <header class="site-header">
    <div class="container">
      <div class="header-row">
        <a href="/" class="site-title">Song's Weblog</a>
        <div class="search-wrap">
          <input type="text" class="search-input" placeholder="Type to search" id="searchInput" autocomplete="off">
          <button class="search-btn" id="searchBtn">Search</button>
          <div class="search-results" id="searchResults"></div>
        </div>
      </div>
    </div>
  </header>

  <div class="container">
    <div class="content-shell">
      <div class="page-layout">
        <div class="main-column">
          <slot />
        </div>

        <aside class="sidebar">
          <div class="sidebar-section">
            <h3>About</h3>
            <p class="sidebar-description">Hi, I'm Song Wang, a Master's candidate in Control Engineering at Huzhou Normal University. Based in Huzhou, I'm currently interning at Zhejiang University Huzhou Institute, exploring the intersections of remote sensing, vision-based perception, and autonomous UAVs/robotics. My undergraduate background is in Automation (2020, Jiangxi University of Water Resources and Electric Power). I use this blog to document my research journey and random curiosities.</p>
          </div>

          <div class="sidebar-section">
            <h3>All Posts</h3>
            <ul class="archive-list">
              {sortedPosts.map(p => (
                <li>
                  <a href={`/posts/${p.slug}/`}>
                    <span class="archive-date">{fmtDate(p.data.date)}</span>
                    {p.data.title || fmtDate(p.data.date)}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div class="sidebar-section">
            <h3>Elsewhere</h3>
            <ul>
              <li><a href="mailto:2024388642@stu.zjhu.edu.cn" class="external">Email</a></li>
              <li><a href="https://github.com/SongSop" class="external">GitHub</a></li>
              <li><a href="https://space.bilibili.com/165317429?spm_id_from=333.1007.0.0" class="external">Bilibili</a></li>
              <li><a href="https://steamcommunity.com/profiles/76561198261665631/" class="external">Steam</a></li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </div>

  <footer class="site-footer">
    <div class="container">
      <p>Powered by <a href="https://astro.build">Astro</a> &middot; Hosted on <a href="https://pages.github.com">GitHub Pages</a></p>
    </div>
  </footer>

  <script src="/search.js"></script>
</body>
</html>
